{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["node", "vite/client"], "allowImportingTsExtensions": false
  },
  "include": ["app/src", "lab", "tools"]
}
